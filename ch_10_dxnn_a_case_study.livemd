Chapter10.Tables.tabs(tbl_tuning_runs,
  [:scope, :seed, :mode, :neurons_in_pool, :patience, :evaluations, :accepted,
   :initial_fitness, :final_fitness, :correct_cases, :stop],
  "ch10_tuning_runs.csv")
