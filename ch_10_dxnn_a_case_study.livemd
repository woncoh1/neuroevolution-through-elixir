  |> Enum.filter(&(&1.mode == :nx))
  |> Enum.map(&Map.merge(&1, %{evaluations: &1.attempt + 1,
    run: "#{&1.scope}/#{&1.seed}"}))
fig_tuning =
  Vl.new(width: 620, height: 280, title: "Local tuning on the fixed XOR fixture")
  |> Vl.data_from_values(fig_tuning_rows)
  |> Vl.mark(:line, point: true)
  |> Vl.encode_field(:x, "evaluations", type: :quantitative, title: "Fitness evaluations")
  |> Vl.encode_field(:y, "best", type: :quantitative, title: "Accepted fitness",
    scale: [zero: false])
  |> Vl.encode_field(:color, "scope", type: :nominal)
