tbl_protocol_checks = Chapter09.Protocol.regressions() ++ Chapter09.Experiments.architecture_checks()
Chapter09.Tables.tabs(tbl_protocol_checks, [:check, :result], "ch_09_tbl_04_protocol_checks.csv")
```

```elixir
tbl_protocols = Enum.flat_map([:actor, :tensor, :hybrid], fn mode ->
  Chapter09.Protocol.summary(Chapter09.DiagnosticFixtures.clock(), "clock", mode) ++
  Chapter09.Protocol.summary(Chapter09.Fixtures.known_xor(), "tanh XOR", mode)
end)
Chapter09.Tables.tabs(tbl_protocols, [:fixture, :mode, :protocol, :accuracy, :mae, :fitness],
  "ch_09_tbl_05_protocol_outcomes.csv")
