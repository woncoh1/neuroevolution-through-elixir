tbl_ordering = [
  %{test: "Reverse arrival plus duplicate", observed: inspect(ordering_result.neuron),
    expected: inspect(ordering_result.expected)},
  %{test: "Actuator fan-in order plus foreign epoch", observed: inspect(ordering_result.ordered_actuator),
    expected: "[7.0, 22.0]"}
]
Chapter06.Tables.tabs(tbl_ordering, [:test, :observed, :expected], "ch_06_tbl_08_message_order.csv")
