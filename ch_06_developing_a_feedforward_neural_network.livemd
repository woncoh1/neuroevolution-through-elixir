  {2, [], 1},
  {2, [1, 3], 1},
  {3, [3, 2], 2},
  {2, [4, 4], 2}
] |> Enum.with_index(1) |> Enum.map(fn {shape, seed} ->
  Chapter06.Experiments.parity_case(shape, seed)
end)
Chapter06.Tables.tabs(tbl_shape_parity,
  [:shape, :examples, :actor_error, :tensor_error, :hybrid_error, :cycles, :backups_equal, :cleaned_up],
  "ch_06_tbl_07_shape_parity.csv")
