  Chapter07.Support.check!(Chapter07.Layout.flatten(round_trip) == result_actor.theta,
    "ETS save/load preserves trained parameters"),
  Chapter07.Support.check!(Chapter07.Store.decode(Chapter07.Store.encode(result_actor.genotype)) == result_actor.genotype,
    "Versioned checkpoint round-trip"),
  Chapter07.Support.check!(is_binary(Chapter07.Tables.csv(tbl_runs, [:implementation, :fitness])),
    "CSV download callback returns binary content")
]
tbl_search_checks = checks_search ++ checks_storage
Chapter07.Tables.tabs(tbl_search_checks, [:check, :result], "ch_07_tbl_09_search_and_storage_checks.csv")
